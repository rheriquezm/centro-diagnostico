# === Aplicacion ===
APP_NAME=Centro de Diagnostico
ENVIRONMENT=development
SECRET_KEY=cambia-esta-clave-por-una-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === PostgreSQL ===
POSTGRES_USER=centro
POSTGRES_PASSWORD=centro_pass
POSTGRES_DB=centro_diagnostico
DATABASE_URL=postgresql+psycopg2://centro:centro_pass@db:5432/centro_diagnostico

# === Puertos / Frontend ===
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# === CORS ===
CORS_ORIGINS=http://localhost:3000

# === Autenticacion (Google OAuth) ===
GOOGLE_CLIENT_ID=
ALLOWED_EMAILS_FILE=allowed_emails.json
# Permite el acceso a todos los correos de estos dominios (separados por coma)
ALLOWED_DOMAINS=
# Habilita /api/auth/dev-login SOLO para desarrollo local (nunca en produccion)
DEV_LOGIN_ENABLED=false

# === Redmine (API de solo lectura) ===
REDMINE_URL=https://www.guadaltel.es/redmine
REDMINE_API_KEY=
REDMINE_PROJECT_ID=
REDMINE_VERIFY_SSL=true
REDMINE_TIMEOUT=60

# === Graylog (usuario/token de solo lectura) ===
GRAYLOG_URL=https://adp.serviciocivil.cl/graylog
GRAYLOG_API_TOKEN=
GRAYLOG_USER=
GRAYLOG_PASSWORD=
GRAYLOG_VERIFY_SSL=true
GRAYLOG_TIMEOUT=60
GRAYLOG_STREAMS=

# === Motor IA (none | ollama | openai) ===
# none   -> diagnostico heuristico (sin LLM)
# ollama -> LLM local (recomendado para datos institucionales)
# openai -> ChatGPT via API compatible OpenAI (requiere AI_API_KEY)
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
# Ollama en Docker Compose (perfil llm): http://ollama:11434
# Ollama en el host: http://host.docker.internal:11434
# OpenAI/ChatGPT: https://api.openai.com/v1
AI_BASE_URL=

# Limites del motor IA (evitan respuestas que se cuelgan)
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_STACK_CHARS=1200

# Puerto de Ollama (perfil "llm")
OLLAMA_PORT=11434

# === Ingesta / Analisis ===
SYNC_LOOKBACK_HOURS=24
FINGERPRINT_SAMPLES=5

# === Sincronizacion automatica ===
SCHEDULER_ENABLED=true
SYNC_INTERVAL_MINUTES=60
REDMINE_SYNC_MAX_ISSUES=500
GRAYLOG_SYNC_QUERY=*
GRAYLOG_SYNC_RANGE_HOURS=24
GRAYLOG_SYNC_MAX_MESSAGES=2000

# === Cerradura Yale Connect (ASSA ABLOY) ===
YALE_BASE_URL=https://api.connectservices.assaabloy.com/api/YaleConnect/
YALE_EMAIL=
YALE_PASSWORD=
YALE_HOME_ID=
YALE_SYNC_DAYS=7
YALE_VERIFY_SSL=true

# === Control de acceso ZKBio CVAccess (ZKTeco) ===
ZKBIO_BASE_URL=http://accesos.serviciocivil.cl:8098
ZKBIO_USERNAME=admin
ZKBIO_PASSWORD=
ZKBIO_TIMEOUT=60
ZKBIO_SYNC_DAYS=7
ZKBIO_PAGE_SIZE=200000
